    "diagnosisPatterns": [
      "(?:dedup(?:lication)?|idempotency)[^\\n.]{0,120}(?:sequence|seq)[^\\n.]{0,120}(?:device|collision|cross)",
      "(?:sequence|seq)[^\\n.]{0,100}(?:alone|only|without|omitt?ed)[^\\n.]{0,100}(?:device|dedup|idempotency)",
      "(?:cross[- ]device|across devices)[^\\n.]{0,100}(?:dedup|duplicate|collision)",
