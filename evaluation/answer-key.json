      "L-033",
      "L-035",
      "M-038"
    ],
    "additionalSupportingEvidenceIds": [
      "L-031",
      "L-032",
      "L-034",
      "L-036",
      "L-037",
      "M-035",
      "M-036",
      "M-037",
      "M-039",
      "M-040"
    ],
    "alternativeCausesNotSupported": [
      "DISK_EXHAUSTION",
      "BROKER_OUTAGE",
      "MQTT_AUTHENTICATION_FAILURE",
      "MQTT_TOPIC_NAMESPACE_MISMATCH",
      "SCHEMA_INCOMPATIBILITY",
      "NETWORK_DELIVERY_DELAY",
      "OLD_MESSAGE_REPLAY"
    ],
    "diagnosisPatterns": [
      "\\b(?:clock\\s+(?:skew|drift|offset)|unsynchroni[sz]ed\\s+(?:publisher\\s+|device\\s+|edge\\s+)?clock)\\b",
      "\\b(?:publisher|device|edge)\\b[^\\n.]{0,120}\\bclock\\b[^\\n.]{0,120}\\b(?:behind|slow|skewed|incorrect|unsynchroni[sz]ed)\\b",
      "\\b(?:stale|old|expired)\\s+(?:event\\s+)?timestamps?\\b[^\\n.]{0,120}\\b(?:clock|skew|offset|time\\s+sync)\\b",
      "\\b(?:clock|time\\s+sync)\\b[^\\n.]{0,120}\\b(?:freshness|age|stale|discarded|dropped|rejected)\\b"
    ]
  },
  "INC-005": {
    "rootCauseCode": "CROSS_DEVICE_DEDUPLICATION_KEY_COLLISION",
    "rootCauseDescription": "A downstream deduplicator rollout changed the idempotency key from (device_id, sequence) to sequence alone. Distinct line-a and line-b devices used overlapping per-device sequence numbers, so after line-a messages were accepted the distinct line-b messages collided with existing deduplication keys and were incorrectly suppressed despite successful MQTT delivery and schema validation.",
