  "INC-003": {
    "rootCauseCode": "MQTT_TOPIC_NAMESPACE_MISMATCH",
    "rootCauseDescription": "Publisher rollout changed the MQTT telemetry topic namespace to v2, but the consumer remained subscribed to v1/#, so broker-accepted messages did not match the consumer subscription.",
    "requiredEvidenceIds": [
      "L-022",
      "L-024",
      "M-025"
    ],
    "additionalSupportingEvidenceIds": [
      "L-023",
      "M-023",
      "M-024",
      "L-027",
      "M-022",
      "M-027",
      "M-026"
    ],
    "alternativeCausesNotSupported": [
      "DISK_EXHAUSTION",
      "BROKER_OUTAGE",
      "MQTT_AUTHENTICATION_FAILURE"
    ],
    "diagnosisPatterns": [
      "\\b(?:root\\s+cause|diagnosis|due\\s+to|caused\\s+by)\\s*[:\\-]?\\s*(?:an?\\s+)?(?:mqtt\\s+)?(?:topic(?:\\s+namespace)?|subscription(?:\\s+filter)?)\\s+(?:mismatch|misalignment|drift)\\b",
      "\\b(?:topic(?:\\s+namespace)?|subscription(?:\\s+filter)?)\\s+(?:mismatch|misalignment|drift)\\b[^\\n.]{0,100}\\b(?:caused|broke|prevented|stopped|led\\s+to)\\b",
      "\\b(?:publisher|published|publishing)\\b[^\\n.]{0,120}\\bv2\\b[^\\n.]{0,120}\\b(?:consumer|subscriber|subscription)\\b[^\\n.]{0,120}\\bv1\\b",
      "\\b(?:consumer|subscriber|subscription)\\b[^\\n.]{0,120}\\bv1\\b[^\\n.]{0,120}\\b(?:publisher|published|publishing)\\b[^\\n.]{0,120}\\bv2\\b"
    ]
  },
  "INC-004": {
    "rootCauseCode": "PUBLISHER_CLOCK_SKEW",
    "rootCauseDescription": "After reboot, the publisher's unsynchronized system clock lagged trusted time by approximately 480 seconds. Newly sampled telemetry carried event timestamps older than the consumer's 120-second freshness limit, so the consumer received but discarded the messages.",
